type tie<tsh>
// gen-docs.tsh.tie —— tdiag 家族文档生成器（tsh 角色，全面代替原 gen-docs.ps1）
// ============================================================
// 读 docs/diagcodes.data.tie（td 数据表字面量，由 tie-main/scripts/gen-diagcodes.tie
// 生成；不用 JSON），按家族分节输出单一 docs/error.md：每条标号含 消息模板 /
// 出处 / 成因 / 常见解决方案。成因与方案来自内置 nameMap/prefMap（按消息名前缀）；
// 未覆盖条目用家族级默认说明兜底。
//
// 运行（在 tdiag 仓库根）：
//   <tsh-main> -f docs\gen-docs.tsh.tie [输出路径(默认 docs/error.md)]
// 输出与 gen-docs.ps1 逐字节一致（\r\n=AppendLine；famIntro 内联 LF；转义见 do_unescape）。
//
// tsh 运行时约束（已规避）：
//  1. 顶层/函数内不允许“一行多 `var`”，块内 `; return`；→ 均已改写；
//  2. 有局部变量的函数互相调用会破坏调用方局部槽 → 辅助函数一律
//     无参数、零局部变量、仅经全局量 g_* 读写；
//  3. 长时运行后“当前函数”后续新声明的局部变量可能失效 → 读取与生成
//     拆分为两个独立函数 read_input / emit_all，由顶层顺序调用。
//  4. 插入排序不依赖 `j>=0 && fc[j]`（无短路）→ 双层 if 改写。

// ---------- 全局子函数状态 ----------
var g_line = ""
var g_needle = ""
var g_pos = -1
var g_i = 0
var g_hn = 0
var g_nn = 0
var g_start = 0
var g_buf = ""
var g_c = ""
var g_nx = ""
var g_n = 0

// 在 g_line 中找 g_needle 的首次出现 → g_pos（未找到 -1）。
func do_find() {
    g_hn = str_len(g_line)
    g_nn = str_len(g_needle)
    g_pos = -1
    if g_nn == 0 {
        g_pos = 0
        return
    }
    if g_nn > g_hn {
        return
    }
    g_i = 0
    while g_i <= g_hn - g_nn {
        if substr(g_line, g_i, g_i + g_nn) == g_needle {
            g_pos = g_i
            return
        }
        g_i = g_i + 1
    }
}

// 从 g_i 起跳过空白。
func do_skipws() {
    g_n = str_len(g_line)
    while g_i < g_n {
        g_c = substr(g_line, g_i, g_i + 1)
        if g_c == " " || g_c == "\t" {
            g_i = g_i + 1
        } else {
            return
        }
    }
}

// 从 g_start（开引号后一位）解码 td 转义直到未转义闭引号 → g_buf。
func do_unescape() {
    g_buf = ""
    g_n = str_len(g_line)
    g_i = g_start
    while g_i < g_n {
        g_c = substr(g_line, g_i, g_i + 1)
        if g_c == "\\" {
            if g_i + 1 < g_n {
                g_nx = substr(g_line, g_i + 1, g_i + 2)
                if g_nx == "n" { g_buf = g_buf + "\n" }
                else if g_nx == "r" { g_buf = g_buf + "\r" }
                else if g_nx == "t" { g_buf = g_buf + "\t" }
                else if g_nx == "\"" { g_buf = g_buf + "\"" }
                else if g_nx == "\\" { g_buf = g_buf + "\\" }
                else { g_buf = g_buf + g_nx }
                g_i = g_i + 2
            } else {
                g_buf = g_buf + "\\"
                g_i = g_i + 1
            }
        } else if g_c == "\"" {
            return
        } else {
            g_buf = g_buf + g_c
            g_i = g_i + 1
        }
    }
}

// 从 g_i 起读取连续数字 → g_buf。
func do_digits() {
    g_buf = ""
    while g_i < str_len(g_line) {
        g_c = substr(g_line, g_i, g_i + 1)
        if g_c >= "0" && g_c <= "9" {
            g_buf = g_buf + g_c
            g_i = g_i + 1
        } else {
            return
        }
    }
}

// ---------- 家族介绍（逐字取自 ps1 输出，内联 LF；fam9 第2行含 TAB） ----------
var f2 = "tie 语法错误（解析阶段）：期望 X 实际 Y、标签只能用于循环、extern 只能顶层、\n赋值目标非法等。多为漏分号、多/缺括号、关键字位置错误。 / Parser errors:\nexpected X but got Y, label misuse, extern placement, bad assignment target —\nusually missing semicolons/brackets or keyword misplacement."
var f3 = "tie 语义错误（类型/作用域/调用/移动/泛型/宏）：最丰富的一族。类型不匹配、\n未定义符号、ref 实参规则、unsafe 门禁、移动语义、泛型实例化、宏展开都在此。\n多数可按「名字 + 期望/实际」直接定位。 / Semantic errors: the largest family —\ntypes, scopes, calls, ref args, unsafe gates, move semantics, generics, macro\nexpansion. Most resolve via the name plus expected/actual."
var f4 = "tie 运行时/解释器错误（REPL 与内置函数）：内置函数参数错误（len/str_char/…）、\n除零、下标越界、桥函数未 tie 化等。 / Runtime/interpreter errors: builtin\nargument mistakes, divide-by-zero, index out of range, un-tie'd bridge fns."
var f5 = "tie CLI 与配置错误：参数错误、角色声明、config 解析、compress-data、文件读写。\n检查命令行参数、头部角色声明、config.data.tie 与 roles 段格式。 / CLI & config\nerrors: args, role headers, config parsing, compress-data, file IO."
var f6 = "tie 后端与 IR 错误：opt/clang/llvm-ar/lld 工具链失败、tieir 序列化、后端未接入。\n多为环境问题（LLVM 工具缺失/版本）或编译器内部错误。 / Backend & IR errors:\ntoolchain (opt/clang/llvm-ar/lld) failures, tieir serialization, unimplemented\nbackend — often environment (missing LLVM tools) or compiler-internal."
var f7 = "REPL v1 暂不支持项：struct/enum/import/using/元组/字段访问/goto 等解释器路径\n限制——请改用编译路径（tiec 文件编译）。 / REPL v1 limitations: use the\ncompile path (tiec on a file) for these constructs."
var f9 = "内部错误（E9）：编译器自身断言/未实现分支。请提交 issue 并附最小复现与\n\tiec -O0 输出。 / Internal errors: compiler bugs — file an issue with a\nminimal repro."

// ---------- 家族名 ----------
var fnm1 = "词法 / Lexer"
var fnm2 = "语法 / Parser"
var fnm3 = "语义 / Semantic"
var fnm4 = "运行时 / Runtime"
var fnm5 = "CLI 与配置 / CLI & Config"
var fnm6 = "后端与 IR / Backend & IR"
var fnm7 = "REPL"
var fnm9 = "内部错误 / Internal"

