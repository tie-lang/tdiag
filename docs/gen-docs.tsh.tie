// ---------- 结果缓冲 ----------
var allc: table<string> = table_new_string()
var alln: table<string> = table_new_string()
var allt: table<string> = table_new_string()
var alls: table<string> = table_new_string()
var allf: table<i64> = table_new_i64()
var recn: i64 = 0
var out = ""

// ---------- 读取并解析 td 明细 ----------
func read_input() {
    var src = file_read("docs/diagcodes.data.tie")
    var ls = split_lines(src)
    var lnum = len(ls)
    var li: i64 = 0
    while li < lnum {
        var t = ls[li]
        var c0 = ""
        while str_len(t) > 0 {
            c0 = substr(t, 0, 1)
            if c0 == " " || c0 == "\t" {
                t = substr(t, 1, str_len(t))
            } else {
                break
            }
        }
        if str_len(t) == 0 {
            li = li + 1
            continue
        }
        if !has_prefix(t, "[") {
            li = li + 1
            continue
        }
        g_line = t
        g_needle = "\"code\":"
        do_find()
        g_i = g_pos + str_len(g_needle)
        do_skipws()
        g_start = g_i + 1
        do_unescape()
        var cd = g_buf
        g_needle = "\"name\":"
        do_find()
        g_i = g_pos + str_len(g_needle)
        do_skipws()
        g_start = g_i + 1
        do_unescape()
        var nm = g_buf
        g_needle = "\"template\":"
        do_find()
        g_i = g_pos + str_len(g_needle)
        do_skipws()
        g_start = g_i + 1
        do_unescape()
        var tp = g_buf
        g_needle = "\"src\":"
        do_find()
        g_i = g_pos + str_len(g_needle)
        do_skipws()
        g_start = g_i + 1
        do_unescape()
        var sr = g_buf
        g_needle = "\"family\":"
        do_find()
        g_i = g_pos + str_len(g_needle)
        do_skipws()
        do_digits()
        var fm = parse_int(g_buf)
        table_push(allc, cd)
        table_push(alln, nm)
        table_push(allt, tp)
        table_push(alls, sr)
        table_push(allf, fm)
        recn = recn + 1
        li = li + 1
    }
}

// ---------- 生成（独立函数，避开长 run 后同函数后续局部失效） ----------
func emit_all() {
    out = out + "# 错误标号大全 / Error codes" + "\r\n"
    out = out + "\r\n"
    out = out + "> tie 诊断错误共分九大家族（词法/语法/语义/运行时/CLI 与配置/后端与 IR/REPL/内部错误），" + "\r\n"
    out = out + "> 以下按家族分节、族内按标号排序，每条含**消息模板**、**出处**、**成因（如何发生）**与**常见解决方案**。" + "\r\n"
    out = out + "> Errors are grouped by family below (lexer, parser, semantic, runtime, CLI & config, backend & IR, REPL, internal); each entry lists the message template, source, cause and a common fix." + "\r\n"
    out = out + "\r\n"
    var fam: i64 = 1
    while fam <= 9 {
        if fam == 8 {
            fam = fam + 1
            continue
        }
        var fdisp = fnm1
        if fam == 2 { fdisp = fnm2 } else if fam == 3 { fdisp = fnm3 } else if fam == 4 { fdisp = fnm4 } else if fam == 5 { fdisp = fnm5 } else if fam == 6 { fdisp = fnm6 } else if fam == 7 { fdisp = fnm7 } else if fam == 9 { fdisp = fnm9 }
        out = out + "## 家族 " + to_string(fam) + " " + fdisp + "\r\n"
        out = out + "\r\n"
        var fc: table<string> = table_new_string()
        var fn: table<string> = table_new_string()
        var ft: table<string> = table_new_string()
        var fsx: table<string> = table_new_string()
        var cnt: i64 = 0
        var ri: i64 = 0
        while ri < recn {
            if allf[ri] == fam {
                table_push(fc, allc[ri])
                table_push(fn, alln[ri])
                table_push(ft, allt[ri])
                table_push(fsx, alls[ri])
                cnt = cnt + 1
            }
            ri = ri + 1
        }
        if cnt == 0 {
            out = out + "_（暂无条目 / no entries）_" + "\r\n"
            out = out + "\r\n"
            fam = fam + 1
            continue
        }
        if fam == 2 { out = out + f2 } else if fam == 3 { out = out + f3 } else if fam == 4 { out = out + f4 } else if fam == 5 { out = out + f5 } else if fam == 6 { out = out + f6 } else if fam == 7 { out = out + f7 } else if fam == 9 { out = out + f9 }
        out = out + "\r\n"
        out = out + "\r\n"
        // 按码号排序（内建 sort_strings 字节序；码号等长零填充即标号序）
        var scodes = sort_strings(fc)
        var mcnt = len(scodes)
        // 逐条输出（按排序后码号顺序）
        var mk: i64 = 0
        while mk < mcnt {
            var cd2 = scodes[mk]
            var findi: i64 = 0
            var fi = -1
            while findi < cnt {
                if fc[findi] == cd2 {
                    fi = findi
                    break
                }
                findi = findi + 1
            }
            var nm2 = fn[fi]
            var templ = ft[fi]
            var srcc = fsx[fi]
            var bs = ""
            var bestlen: i64 = 0
            var ncau = ""
            var nfix = ""
            if has_prefix(nm2, nkey0) { if str_len(nkey0) > bestlen { bs = nkey0; ncau = ncau0; nfix = nfix0; bestlen = str_len(nkey0) } }
            if has_prefix(nm2, nkey1) { if str_len(nkey1) > bestlen { bs = nkey1; ncau = ncau1; nfix = nfix1; bestlen = str_len(nkey1) } }
            if has_prefix(nm2, nkey2) { if str_len(nkey2) > bestlen { bs = nkey2; ncau = ncau2; nfix = nfix2; bestlen = str_len(nkey2) } }
            if has_prefix(nm2, nkey3) { if str_len(nkey3) > bestlen { bs = nkey3; ncau = ncau3; nfix = nfix3; bestlen = str_len(nkey3) } }
            if has_prefix(nm2, nkey4) { if str_len(nkey4) > bestlen { bs = nkey4; ncau = ncau4; nfix = nfix4; bestlen = str_len(nkey4) } }
            if has_prefix(nm2, nkey5) { if str_len(nkey5) > bestlen { bs = nkey5; ncau = ncau5; nfix = nfix5; bestlen = str_len(nkey5) } }
            if has_prefix(nm2, nkey6) { if str_len(nkey6) > bestlen { bs = nkey6; ncau = ncau6; nfix = nfix6; bestlen = str_len(nkey6) } }
            if has_prefix(nm2, nkey7) { if str_len(nkey7) > bestlen { bs = nkey7; ncau = ncau7; nfix = nfix7; bestlen = str_len(nkey7) } }
            if has_prefix(nm2, nkey8) { if str_len(nkey8) > bestlen { bs = nkey8; ncau = ncau8; nfix = nfix8; bestlen = str_len(nkey8) } }
            if has_prefix(nm2, nkey9) { if str_len(nkey9) > bestlen { bs = nkey9; ncau = ncau9; nfix = nfix9; bestlen = str_len(nkey9) } }
            if has_prefix(nm2, nkey10) { if str_len(nkey10) > bestlen { bs = nkey10; ncau = ncau10; nfix = nfix10; bestlen = str_len(nkey10) } }
            if has_prefix(nm2, nkey11) { if str_len(nkey11) > bestlen { bs = nkey11; ncau = ncau11; nfix = nfix11; bestlen = str_len(nkey11) } }
            if has_prefix(nm2, nkey12) { if str_len(nkey12) > bestlen { bs = nkey12; ncau = ncau12; nfix = nfix12; bestlen = str_len(nkey12) } }
            if has_prefix(nm2, nkey13) { if str_len(nkey13) > bestlen { bs = nkey13; ncau = ncau13; nfix = nfix13; bestlen = str_len(nkey13) } }
            if has_prefix(nm2, nkey14) { if str_len(nkey14) > bestlen { bs = nkey14; ncau = ncau14; nfix = nfix14; bestlen = str_len(nkey14) } }
            if has_prefix(nm2, nkey15) { if str_len(nkey15) > bestlen { bs = nkey15; ncau = ncau15; nfix = nfix15; bestlen = str_len(nkey15) } }
            if has_prefix(nm2, nkey16) { if str_len(nkey16) > bestlen { bs = nkey16; ncau = ncau16; nfix = nfix16; bestlen = str_len(nkey16) } }
            if has_prefix(nm2, nkey17) { if str_len(nkey17) > bestlen { bs = nkey17; ncau = ncau17; nfix = nfix17; bestlen = str_len(nkey17) } }
            if has_prefix(nm2, nkey18) { if str_len(nkey18) > bestlen { bs = nkey18; ncau = ncau18; nfix = nfix18; bestlen = str_len(nkey18) } }
            if has_prefix(nm2, nkey19) { if str_len(nkey19) > bestlen { bs = nkey19; ncau = ncau19; nfix = nfix19; bestlen = str_len(nkey19) } }
            if has_prefix(nm2, nkey20) { if str_len(nkey20) > bestlen { bs = nkey20; ncau = ncau20; nfix = nfix20; bestlen = str_len(nkey20) } }
            if has_prefix(nm2, nkey21) { if str_len(nkey21) > bestlen { bs = nkey21; ncau = ncau21; nfix = nfix21; bestlen = str_len(nkey21) } }
            if has_prefix(nm2, nkey22) { if str_len(nkey22) > bestlen { bs = nkey22; ncau = ncau22; nfix = nfix22; bestlen = str_len(nkey22) } }
            if has_prefix(nm2, nkey23) { if str_len(nkey23) > bestlen { bs = nkey23; ncau = ncau23; nfix = nfix23; bestlen = str_len(nkey23) } }
            if has_prefix(nm2, nkey24) { if str_len(nkey24) > bestlen { bs = nkey24; ncau = ncau24; nfix = nfix24; bestlen = str_len(nkey24) } }
            if has_prefix(nm2, nkey25) { if str_len(nkey25) > bestlen { bs = nkey25; ncau = ncau25; nfix = nfix25; bestlen = str_len(nkey25) } }
            if has_prefix(nm2, nkey26) { if str_len(nkey26) > bestlen { bs = nkey26; ncau = ncau26; nfix = nfix26; bestlen = str_len(nkey26) } }
            if has_prefix(nm2, nkey27) { if str_len(nkey27) > bestlen { bs = nkey27; ncau = ncau27; nfix = nfix27; bestlen = str_len(nkey27) } }
            if has_prefix(nm2, nkey28) { if str_len(nkey28) > bestlen { bs = nkey28; ncau = ncau28; nfix = nfix28; bestlen = str_len(nkey28) } }
            if has_prefix(nm2, nkey29) { if str_len(nkey29) > bestlen { bs = nkey29; ncau = ncau29; nfix = nfix29; bestlen = str_len(nkey29) } }
            if has_prefix(nm2, nkey30) { if str_len(nkey30) > bestlen { bs = nkey30; ncau = ncau30; nfix = nfix30; bestlen = str_len(nkey30) } }
            if has_prefix(nm2, nkey31) { if str_len(nkey31) > bestlen { bs = nkey31; ncau = ncau31; nfix = nfix31; bestlen = str_len(nkey31) } }
            if has_prefix(nm2, nkey32) { if str_len(nkey32) > bestlen { bs = nkey32; ncau = ncau32; nfix = nfix32; bestlen = str_len(nkey32) } }
            var cause = ""
            var fix = ""
            if bs != "" {
                cause = ncau
                fix = nfix
            } else {
                var gi: i64 = 0
                var matched = false
                while gi < 20 {
                    var pk = pkey0
                    if gi == 1 { pk = pkey1 } else if gi == 2 { pk = pkey2 } else if gi == 3 { pk = pkey3 } else if gi == 4 { pk = pkey4 } else if gi == 5 { pk = pkey5 } else if gi == 6 { pk = pkey6 } else if gi == 7 { pk = pkey7 } else if gi == 8 { pk = pkey8 } else if gi == 9 { pk = pkey9 } else if gi == 10 { pk = pkey10 } else if gi == 11 { pk = pkey11 } else if gi == 12 { pk = pkey12 } else if gi == 13 { pk = pkey13 } else if gi == 14 { pk = pkey14 } else if gi == 15 { pk = pkey15 } else if gi == 16 { pk = pkey16 } else if gi == 17 { pk = pkey17 } else if gi == 18 { pk = pkey18 } else if gi == 19 { pk = pkey19 }
                    if has_prefix(nm2, pk) {
                        if gi == 0 { cause = pcau0; fix = pfix0 } else if gi == 1 { cause = pcau1; fix = pfix1 } else if gi == 2 { cause = pcau2; fix = pfix2 } else if gi == 3 { cause = pcau3; fix = pfix3 } else if gi == 4 { cause = pcau4; fix = pfix4 } else if gi == 5 { cause = pcau5; fix = pfix5 } else if gi == 6 { cause = pcau6; fix = pfix6 } else if gi == 7 { cause = pcau7; fix = pfix7 } else if gi == 8 { cause = pcau8; fix = pfix8 } else if gi == 9 { cause = pcau9; fix = pfix9 } else if gi == 10 { cause = pcau10; fix = pfix10 } else if gi == 11 { cause = pcau11; fix = pfix11 } else if gi == 12 { cause = pcau12; fix = pfix12 } else if gi == 13 { cause = pcau13; fix = pfix13 } else if gi == 14 { cause = pcau14; fix = pfix14 } else if gi == 15 { cause = pcau15; fix = pfix15 } else if gi == 16 { cause = pcau16; fix = pfix16 } else if gi == 17 { cause = pcau17; fix = pfix17 } else if gi == 18 { cause = pcau18; fix = pfix18 } else if gi == 19 { cause = pcau19; fix = pfix19 }
                        matched = true
                        gi = 20
                    } else {
                        gi = gi + 1
                    }
                }
                if !matched {
                    cause = "见家族说明 / see family guidance；消息模板见下。"
                    fix = "按模板与「期望/实际」定位；仍未解时参考 [experience.md](experience.md)。"
                }
            }
            out = out + "### " + cd2 + "  " + nm2 + "\r\n"
            out = out + "\r\n"
            out = out + "- 消息模板 / template：`" + templ + "`" + "\r\n"
            out = out + "- 出处 / source：`" + srcc + "`" + "\r\n"
            out = out + "- 成因（如何发生）/ cause：" + cause + "\r\n"
            out = out + "- 常见解决方案 / common fix：" + fix + "\r\n"
            out = out + "\r\n"
            mk = mk + 1
        }
        fam = fam + 1
    }
    var _ok = file_write(opath, out)
}

// ---------- 输出路径（先解析，避免长 run 后污染） ----------
